public class SICVoicePickingProcessingTable extends common
{
    /// <summary>
    /// Determines if concurrent deletes should throw exception.
    /// </summary>
    /// <returns>true, if exception should be thrown; otherwise, false.</returns>
    public boolean shouldThrowExceptionOnZeroDelete()
    {
        return true;
    }

    protected boolean checkProcessing()
    {
        SICVoicePickingProcessingTable processingTable;
        select firstonly recId
            from    processingTable
            where   processingTable.VoicePickingStatus  == SICVoicePickingStatus::Processing
            &&      processingTable.RecId               != this.RecId ;
        return processingTable.RecId != 0 ;
    }

    protected SICVoicePickingProcessingTable findNext()
    {
        SICVoicePickingProcessingTable processingTable;
        select firstonly processingTable
            order by WMHEInboundQueueId asc
            where   processingTable.VoicePickingStatus  == SICVoicePickingStatus::NotProcessed
            &&      processingTable.RecId               != this.RecId ;
        return processingTable ;
    }

    protected boolean isOldestPending()
    {
        SICVoicePickingProcessingTable processingTable;
        select firstonly recId
            from    processingTable
            where   processingTable.VoicePickingStatus   == SICVoicePickingStatus::NotProcessed
            &&      processingTable.RecId                != this.RecId
            &&      processingTable.WMHEInboundQueueId   <  this.WMHEInboundQueueId ;
        return processingTable.RecId == 0 ;
    }

    /// <summary>
    ///
    /// </summary>
    public void insert()
    {
        super();

        // verifie si traitement en cours et qu'aucun message plus ancien n'attend deja :
        // si non lance le traitement sinon attend
        if (!this.checkProcessing() && this.isOldestPending())
        {
            // on lance le traitement
            this.processAsync(this) ;
        }
    }

    protected void processAsync(SICVoicePickingProcessingTable _processingTable)
    {
        SICWMHEWorkConfirmAsync::processAsync(_processingTable) ;
    }

    protected void processSync(SICVoicePickingProcessingTable _processingTable)
    {
        SICWMHEWorkConfirmAsync::processSync(_processingTable) ;
    }

    /// <summary>
    ///
    /// </summary>
    public void update()
    {
        super();

        // vérifie s'il reste des traitements à lancer
        if (this.orig().VoicePickingStatus == SICVoicePickingStatus::Processing
            && (this.VoicePickingStatus == SICVoicePickingStatus::Processed || this.VoicePickingStatus == SICVoicePickingStatus::Error))
        {
            SICVoicePickingProcessingTable processingTable = this.findNext() ;
            if (processingTable.RecId)
            {
                // on lance le traitement suivant en synchrone : on est deja dans une tache
                // asynchrone (pick), un second Global::runAsync imbrique ne demarre pas de facon fiable
                this.processSync(processingTable) ;
            }
        }

    }

}
