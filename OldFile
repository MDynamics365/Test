    protected void setProcessingState(RecId _processingRecId, SICVoicePickingStatus _status)
    {
        UserConnection                  userConnection  = new UserConnection();
        SICVoicePickingProcessingTable  recordToUpdate  ;
        select firstonly forupdate recordToUpdate where recordToUpdate.RecId == _processingRecId ;
        WMHEInboundQueue inboundQueueLocal = WMHEInboundQueue::find(recordToUpdate.WMHEInboundQueueId, true );
        try
        {
            if (recordToUpdate.RecId)
            {
                recordToUpdate.setConnection(userConnection);
                userConnection.ttsbegin();
                recordToUpdate.VoicePickingStatus = _status ;
                recordToUpdate.update() ;
                userConnection.ttscommit();
                //Ajouter au log l'étape de la mise à jour du statut du champ VoicePickingStatus de la table SICVoicePickingProcessingTable
                SICVoicePickingProcessingLogTable::addLog(inboundQueueLocal.MessageId, SICVoicePickingLogType::Step, strFmt("@SIC:SICVoicePickingProcessingTableUpdateStatusLog", _status));
                ttsbegin ;
                inboundQueueLocal.SICVoicePickingStatus = _status ;
                inboundQueueLocal.doUpdate() ;
                //Ajouter au log l'étape de la mise à jour du statut du champ SICVoicePickingStatus de la table WMHEInboundQueue
                SICVoicePickingProcessingLogTable::addLog(inboundQueueLocal.MessageId, SICVoicePickingLogType::Step, strFmt("@SIC:WMHEInboundQueueUpdateSICStatusLog", _status));
                ttscommit ;
            }
        }
        finally
        {
            userConnection.finalize();
        }
    }
